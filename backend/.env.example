# Copy this file to .env and fill in real values. .env itself should never
# be committed — it's already covered by .gitignore. This template IS
# committed, so keep it free of real credentials.

# Local Docker Postgres (matches docker-compose.yml defaults):
DATABASE_URL=postgresql+psycopg://supplement_user:supplement_pass@localhost:5432/supplement_tracker

# Signs auth tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# When you deploy to a managed provider (Render, Railway, Supabase, etc.),
# replace this with the connection string they give you — the app code
# doesn't change, only this value does.

# ---------------------------------------------------------------------------
# Email notifications (low/critical/overdue stock)
# ---------------------------------------------------------------------------
# Leave SMTP_HOST empty to disable real sending — emails then print to the
# console instead, which is what tests and most local dev want.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Gmail: use an App Password, NOT your account password
# (Google Account -> Security -> 2-Step Verification -> App passwords).
SMTP_PASSWORD=
# The address the message is sent FROM. For Gmail this must match
# SMTP_USERNAME exactly (or a verified alias) or Gmail rejects the message.
SMTP_FROM_EMAIL=

# Shared secret for POST /notifications/run. Callers must send it in the
# X-Notifications-Secret header. If this is unset the endpoint always 401s.
# Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
NOTIFICATIONS_SECRET=
